[Unit]
Description=BCL 갤러리 얼굴 매칭 워커 (insightface)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bcl-face
EnvironmentFile=/opt/bcl-face/.env
ExecStart=/opt/bcl-face/venv/bin/python worker.py
Restart=always
RestartSec=10
# CPU 전용 추론 — 다른 서비스 보호(8코어 중 4 제한)
CPUQuota=400%

[Install]
WantedBy=multi-user.target
