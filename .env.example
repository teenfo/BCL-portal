# BCL Portal 서버 환경 템플릿 (/opt/bcl-portal/.env). 실제 .env는 커밋 금지(.gitignore).
# ── portal (빌드타임 임베드 — anon key는 공개 안전) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# race-service REST/ws 주소(설정 시 Class 화면이 브릿지 라이브데이터 사용, 없으면 Realtime 폴백)
NEXT_PUBLIC_RACE_SERVICE_URL=

# ── 포트(docs/11 §2.2 표준 — 운영/staging 분리) ──────────────────────────
PORTAL_HOST_PORT=3001        # staging=3101
RACE_HOST_PORT=8001          # staging=8101

# ── race-service (SRK는 race-service env로만 — 클라 노출 금지) ───────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── 결제 환경 이중장치(docs/08 §1.4) ─────────────────────────────────────
# prod = 운영 Supabase 프로젝트에서만. staging/dev = simulation 강제.
PAYMENT_ENV=dev
